# Server-side API Proxy Configuration (Optional for Gemini AI)
# Never commit actual secret keys to source repositories.

# Port for local dev server
PORT=3000

# Google Gemini API Key for server-side Generative AI summaries
# If left empty, Behavior-X automatically switches to the built-in
# Deterministic Rule-Based Fallback Engine without disrupting the dashboard.
GEMINI_API_KEY=your_gemini_api_key_here
